<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Suppress DotCompute kernel analyzer suggestions and known generator issues -->
    <!-- DC* warnings are performance/optimization suggestions from DotCompute analyzers -->
    <!-- CS1591: Source generator doesn't create XML comments for generated code -->
    <!-- IL2095: DotCompute message queue AOT trim analysis - tracked upstream -->
    <!-- CS9057: DotCompute.Generators.dll targets Roslyn 5.3 but SDK ships 5.0 - analyzer won't load but build is unaffected -->
    <NoWarn>$(NoWarn);CS1591;CS8669;CS9057;DC002;DC004;DC005;DC009;DC010;DC011;DC0004;DC0005;IL2095</NoWarn>
  </PropertyGroup>

  <!-- Expose internal types to test assembly -->
  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.GpuBridge.Backends.DotCompute.Tests" />
    <InternalsVisibleTo Include="BackendIntegrationTest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Package Metadata -->
    <PackageId>Orleans.GpuBridge.Backends.DotCompute</PackageId>
    <Title>Orleans GPU Bridge DotCompute Backend</Title>
    <Description>DotCompute backend provider for Orleans.GpuBridge.Core - Enables GPU acceleration via CUDA, Metal, and CPU with attribute-based kernel definition.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Orleans.GpuBridge Dependencies -->
    <ProjectReference Include="..\Orleans.GpuBridge.Abstractions\Orleans.GpuBridge.Abstractions.csproj" />
    <ProjectReference Include="..\Orleans.GpuBridge.Runtime\Orleans.GpuBridge.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DotCompute Framework v0.5.3 (Stable NuGet Release from nuget.org) -->
    <!-- v0.5.3 adds GeneratedRegex, code quality fixes, and documentation improvements -->
    <PackageReference Include="DotCompute.Abstractions.V2" Version="$(DotComputeVersion)" />
    <PackageReference Include="DotCompute.Core.V2" Version="$(DotComputeVersion)" />
    <PackageReference Include="DotCompute.Runtime.V2" Version="$(DotComputeVersion)" />
    <PackageReference Include="DotCompute.Backends.CPU.V2" Version="$(DotComputeVersion)" />
    <PackageReference Include="DotCompute.Backends.CUDA.V2" Version="$(DotComputeVersion)" />

    <!-- DotCompute Source Generators -->
    <!-- The v1.0 generator emits per-kernel wrappers/stubs but NOT a runtime factory;
         CustomRingKernelRuntimeFactory provides that factory for us. -->
    <PackageReference Include="DotCompute.Generators.V2" Version="$(DotComputeVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

    <!-- Orleans Dependencies -->
    <PackageReference Include="Microsoft.Orleans.Core" Version="$(MicrosoftOrleansVersion)" />
    <PackageReference Include="Microsoft.Orleans.Runtime" Version="$(MicrosoftOrleansVersion)" />

    <!-- Microsoft Extensions - Match Orleans.GpuBridge.Abstractions requirements -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.6" />
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.0" />
  </ItemGroup>

  <!-- Include manual CUDA handler files as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Temporal\Handlers\*.cu" />
    <Content Include="Temporal\Handlers\*.cu" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
